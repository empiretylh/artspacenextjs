<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/offline_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/offline_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:src="@drawable/offline_logo" />

    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_icon_circle">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:contentDescription="@string/offline_title"
            android:src="@drawable/ic_wifi_off"
            android:tint="@color/offline_muted" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/offline_title"
        android:textColor="@color/offline_foreground"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxWidth="280dp"
        android:text="@string/offline_message"
        android:textColor="@color/offline_muted"
        android:textSize="14sp" />

    <Button
        android:id="@+id/offline_retry"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_primary_button"
        android:backgroundTint="@color/offline_button_background"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="@string/offline_retry"
        android:textAllCaps="false"
        android:textColor="@color/offline_button_text"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
