rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // HELPERS
    function isSignedIn() {
      return request.auth != null;
    }

    function getConversation(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId)).data;
    }

    function isBlockedBy(userId, blockedByUserId) {
      return exists(/databases/$(database)/documents/users/$(blockedByUserId)/blocks/$(userId));
    }

    function getOtherParticipant(convId) {
      let participants = getConversation(convId).participants;
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    function isIndexReactionValid(idx) {
      return (
        (
          (!("mediaReactions" in request.resource.data) || !(idx in request.resource.data.mediaReactions)) &&
          (!("mediaReactions" in resource.data) || !(idx in resource.data.mediaReactions))
        ) ||
        (
          ("mediaReactions" in request.resource.data && idx in request.resource.data.mediaReactions) &&
          (!("mediaReactions" in resource.data) || !(idx in resource.data.mediaReactions)) &&
          request.resource.data.mediaReactions[idx].keys().hasOnly([request.auth.uid])
        ) ||
        (
          (!("mediaReactions" in request.resource.data) || !(idx in request.resource.data.mediaReactions)) &&
          ("mediaReactions" in resource.data && idx in resource.data.mediaReactions) &&
          resource.data.mediaReactions[idx].keys().hasOnly([request.auth.uid])
        ) ||
        (
          ("mediaReactions" in request.resource.data && idx in request.resource.data.mediaReactions) &&
          ("mediaReactions" in resource.data && idx in resource.data.mediaReactions) &&
          (
            request.resource.data.mediaReactions[idx] == resource.data.mediaReactions[idx] ||
            request.resource.data.mediaReactions[idx].diff(resource.data.mediaReactions[idx]).affectedKeys().hasOnly([request.auth.uid])
          )
        )
      );
    }
    
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;

      // Sub-collection for scalable blocking
      match /blocks/{blockedId} {
        // Strict: Only the owner can read/write their block list
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /conversations/{conversationId} {
      // For creation, we check participants list in request and verify no blocks exist in private records
      allow create: if isSignedIn() && 
        request.auth.uid in request.resource.data.participants &&
        !exists(/databases/$(database)/documents/users/$(request.resource.data.participants[0])/blocks/$(request.resource.data.participants[1])) &&
        !exists(/databases/$(database)/documents/users/$(request.resource.data.participants[1])/blocks/$(request.resource.data.participants[0]));

      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in getConversation(conversationId).participants;
        
        // Prevent sending messages if the conversation metadata has any blocks
        allow create: if isSignedIn() && 
          request.auth.uid in getConversation(conversationId).participants &&
          (!("blockedBy" in getConversation(conversationId)) || 
           getConversation(conversationId).blockedBy.keys().size() == 0);

        // Allow reactions or mediaReactions updates only
        allow update: if isSignedIn() && 
          request.auth.uid in getConversation(conversationId).participants &&
          (!("blockedBy" in getConversation(conversationId)) || 
           getConversation(conversationId).blockedBy.keys().size() == 0) &&
          (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
              (
                !("reactions" in request.resource.data) ||
                (
                  !("reactions" in resource.data) &&
                  request.resource.data.reactions.size() == 1 &&
                  request.auth.uid in request.resource.data.reactions
                ) ||
                (
                  "reactions" in resource.data &&
                  request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])
                )
              )
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mediaReactions']) &&
              isIndexReactionValid('0') &&
              isIndexReactionValid('1') &&
              isIndexReactionValid('2') &&
              isIndexReactionValid('3') &&
              isIndexReactionValid('4') &&
              isIndexReactionValid('5') &&
              isIndexReactionValid('6') &&
              isIndexReactionValid('7') &&
              isIndexReactionValid('8') &&
              isIndexReactionValid('9')
            )
          );
      }
    }
  }
}
