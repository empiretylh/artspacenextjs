rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is logged in
    function isSignedIn() {
      return request.auth != null;
    }

    match /conversations/{conversationId} {
      // CREATE: Allow if the user is one of the participants in the new data
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      
      // READ/UPDATE: Allow if the user is one of the participants in the existing data
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        // Messages: Allow if the user is a participant in the parent conversation
        allow read, create: if isSignedIn() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
  }
}
